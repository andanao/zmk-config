/*                KEY POSITIONS

  ╭─────────────────────╮ ╭─────────────────────╮
  │ LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 │
  │ LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 │
  │ LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 │
  ╰───────────╮ LH1 LH0 │ │ RH0 RH1 ╭───────────╯
              ╰─────────╯ ╰─────────╯

  Column 0 is the *inner* column (index finger), 4 the outer (pinky). These
  labels come from the per-board key-labels header included by the board's
  entry keymap, so the combos below work unchanged on any board. */

// The 3-argument form of ZMK_COMBO emits no `layers` property, which means
// "active on every layer" — matching how these combos behaved before the
// zmk-helpers migration.

/* Modifiers — vertical pairs, one per column, mirrored.
 *
 * A vertical pair is same-column and therefore same-finger, so one finger spans
 * both switches and normal typing can never roll into it: rolls travel across
 * columns, not down them. That is why these need no bigram check, unlike the
 * horizontal combos further down.
 *
 * Allocated by finger strength, strongest to weakest:
 *   index  Ctrl    middle  Gui    ring  Alt    pinky  Shift / Esc
 */
ZMK_COMBO(l_ctrl,      &kp LCTRL,          LT1 LM1)         // R + F
ZMK_COMBO(r_ctrl,      &kp LCTRL,          RT1 RM1)         // U + J
ZMK_COMBO(l_gui,       &kp LGUI,           LT2 LM2)         // E + D
ZMK_COMBO(r_gui,       &kp LGUI,           RT2 RM2)         // I + K
ZMK_COMBO(l_alt,       &kp LALT,           LT3 LM3)         // W + S
ZMK_COMBO(r_alt,       &kp LALT,           RT3 RM3)         // O + L
ZMK_COMBO(r_shift,     &kp LSHFT,          RT4 RM4)         // P + ;
ZMK_COMBO(esc,         &kp ESC,            LT4 LM4)         // Q + A


/* Alt+X needs its own combo for the same reason Ctrl+V does: the modifier and
 * the letter share a column, so one finger would have to press both. Left Alt
 * is column 3 and so is X. It takes the slot Ctrl+X used to have -- M-x earns
 * it more than cut does, and cut is still Ctrl-combo then X, which works
 * because Ctrl is column 1 and X is column 3. */
ZMK_COMBO(alt_x,       &kp LA(X),          LB3 LM3)         // X + S

/* Enter the bootloader, per half, without going through a layer. Reset
 * behaviours run on the half the keys are pressed on, so each half can be put
 * into flashing mode alone. Five keys and a wider window: impossible to hit by
 * accident, deliberate to hit on purpose. Note combos are processed on the
 * central, so the right-hand one still needs the halves connected. */
ZMK_COMBO(boot_l,      &bootloader,        LT4 LT2 LT0 LB4 LH0, DEF LOWER RAISE NUM ADMIN, 200)
ZMK_COMBO(boot_r,      &bootloader,        RT0 RT2 RT4 RB4 RH0, DEF LOWER RAISE NUM ADMIN, 200)

/* Navigation — same-column or same-finger, so none of these can be rolled into.
 * Puts the paging cluster within reach without holding a layer. */
ZMK_COMBO(pg_up,       &kp PG_UP,          LT0 LM0)         // T + G
ZMK_COMBO(pg_dn,       &kp PG_DN,          LM0 LB0)         // G + B
ZMK_COMBO(home,        &kp HOME,           LB3 LB2)         // X + C
ZMK_COMBO(end,         &kp END,            LB2 LB1)         // C + V

/* Layer access */
ZMK_COMBO(num_layer,   &mo NUM,            LM2 LM3)         // D + S
ZMK_COMBO(admin_layer, &mo ADMIN,          RH0 RB4)         // inner thumb + /

/* Whitespace & deletion */
ZMK_COMBO(ret_l,       &kp RET,            LB4 LM4)         // Z + A
ZMK_COMBO(ret_r,       &kp RET,            RM4 RB4)         // ; + /
ZMK_COMBO(backspace,   &kp BSPC,           RM1 RM2)         // J + K
ZMK_COMBO(c_backspace, &kp RC(BSPC),       RM2 RM3)         // K + L
ZMK_COMBO(del,         &kp DEL,            RM1 RM3)         // J + L

/* Symbols */
ZMK_COMBO(asterisk,    &kp ASTERISK,       RT0 RT1)         // Y + U
ZMK_COMBO(hash,        &kp HASH,           LM1 LM0)         // F + G
ZMK_COMBO(caret,       &kp CARET,          RT0 RM0)         // Y + H
ZMK_COMBO(pipe,        &kp PIPE,           RB3 RB4)         // . + /
ZMK_COMBO(grave,       &kp GRAVE,          RM3 RM4)         // L + ;
ZMK_COMBO(amps,        &kp AMPS,           LB1 LB0)         // V + B
ZMK_COMBO(excl,        &kp EXCL,           LT4 LT3)         // Q + W
ZMK_COMBO(at,          &kp AT,             LB4 LB3)         // Z + X
ZMK_COMBO(dllr,        &kp DLLR,           RT0 RT2)         // Y + I
ZMK_COMBO(prcnt,       &kp PRCNT,          RM0 RM2)         // H + K
ZMK_COMBO(sqt,         &kp SQT,            RM1 RM4)         // J + ;
ZMK_COMBO(minus,       &kp MINUS,          RM0 RM1)         // H + J
ZMK_COMBO(plus,        &kp PLUS,            RB0 RB1)         // N + M
ZMK_COMBO(underscore,  &kp UNDERSCORE,     RM1 RB1)         // J + M
ZMK_COMBO(equal,       &kp EQUAL,          RM0 RB0)         // H + N
ZMK_COMBO(lbkt,        &kp LBKT,           RM2 RB2)         // K + ,
ZMK_COMBO(rbkt,        &kp RBKT,           RM3 RB3)         // L + .
ZMK_COMBO(lpar,        &kp LPAR,           RB1 RB2)         // M + ,
ZMK_COMBO(rpar,        &kp RPAR,           RB2 RB3)         // , + .

/* Clipboard */
ZMK_COMBO(c_c,         &kp RC(C),          LB2 LM2)         // C + D
ZMK_COMBO(c_v,         &kp RC(V),          LB1 LM1)         // V + F
