/*
 * Handwired 5-column Corne. 4x5 matrix per half (3 alpha rows + a thumb row
 * using 3 of the 5 columns), col2row, nice!nano v2 per half over BLE.
 *
 * The physical layout is borrowed from ZMK's Corne: foostan_corne_5col_layout
 * is exactly 3x5+3 per half, and its key order matches zmk-helpers' 36.h, so
 * config/handwired_corne.keymap needs no adapter. Only the matrix transform
 * below is specific to this board.
 *
 *  LEFT                                RIGHT
 *  cols L->R: P1.13 P1.00 P0.11        cols L->R: P0.10 P1.11 P1.13
 *             P1.04 P1.06                         P1.06 P0.24
 *  rows T->B: P1.11 P0.10 P0.09 P1.15  rows T->B: P1.00 P0.11 P1.04 P0.09
 *
 * Thumbs hang off the column above them: left thumbs occupy columns 2..4
 * (so the innermost thumb shares the T/G/B column), right thumbs columns 0..2
 * (innermost shares the Y/H/N column).
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/foostan/corne/5column.dtsi>

&foostan_corne_5col_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    // Left half occupies columns 0-4; the right half's overlay sets
    // col-offset = <5> so its local columns 0-4 land on 5-9.
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
// |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
//             | l2  | l1  | l0  |   | r0  | r1  | r2  |
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)  RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)  RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)  RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                RC(3,2) RC(3,3) RC(3,4)  RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    // row-gpios and col-gpios differ between the halves, so both are set in
    // handwired_corne_left.overlay / handwired_corne_right.overlay.
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
    };
};
